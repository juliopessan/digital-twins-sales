ANTHROPIC_API_KEY=sk-ant

# Alternate provider — pick "deepseek" per-run in the Web UI / API instead
# of Anthropic. Optional if you only ever use Anthropic.
# DEEPSEEK_API_KEY=sk-...

# Optional overrides — defaults live in digital_twins/config.py
# DT_PERSONA_MODEL=claude-haiku-4-5-20251001
# DT_FACILITATOR_MODEL=claude-sonnet-4.5
# DT_SYNTHESIZER_MODEL=claude-sonnet-4.5
# DT_DEEPSEEK_MODEL=deepseek-v4-pro
# DT_MAX_ROUNDS=5

# Token-economy gate (digital_twins/llm/governance.py, backed by Tollgate:
# https://github.com/juliopessanuk/toolgate). Optional — defaults to
# ~/.digital-twins/tollgate.db and works with zero configuration.
# TOLLGATE_DB=~/.digital-twins/tollgate.db
